{
  "name": "medical-scope-report",
  "productName": "Medical Scope Report",
  "version": "3.1.1",
  "description": "This is a medical application for creating pdf reports got from a scope machine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build:win32": "set NODE_ENV=production && electron-builder --win --ia32",
    "pack:win32": "set NODE_ENV=production && electron-builder --dir --win --ia32",
    "build:mac": "NODE_ENV=production electron-builder --mac",
    "pack:mac": "NODE_ENV=production electron-builder --dir --mac",
    "clean": "rm -rf release-builds node_modules && npm install"
  },
  "keywords": [
    "Medical",
    "scope",
    "application"
  ],
  "author": "Twelveinks Company Limited",
  "license": "CC0-1.0",
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "sharp": "^0.34.4"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "dcmjs-dimse": "^0.3.2",
    "electron-localshortcut": "^3.2.1",
    "electron-log": "^5.4.3",
    "electron-pdf": "^25.0.0",
    "electron-pdf-window": "^1.0.0",
    "glob": "^10.4.5",
    "image-compressor.js": "^1.1.4",
    "jimp": "^1.6.0",
    "jquery": "^3.4.1",
    "jquery-ui": "^1.12.1",
    "js-datepicker": "^4.0.6",
    "rcedit": "^1.1.1",
    "update-electron-app": "^3.1.1",
    "url": "^0.11.4"
  },
  "build": {
    "appId": "com.twelveinks.med-scope-report",
    "productName": "Med Scope Report",
    "asar": true,
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "**/*",
      "assets/**/*",
      "lib/**/*",
      "main-process/**/*",
      "renderer-process/**/*",
      "sections/**/*",
      "*.js",
      "*.html",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/img/65x65.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ],
      "icon": "assets/img/appicon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Medical Scope Report"
    }
  }
}
